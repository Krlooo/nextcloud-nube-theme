<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
	<id>nube_theme</id>
	<name>Nube theme</name>
	<summary>Make Nextcloud look like Google Drive, in light and dark mode</summary>
	<description>A theme that gives Nextcloud the look of Google Drive and Google Workspace: sign-in card, rounded search, pill navigation, gray folders, and Material 3 controls. It only adds CSS on top of the Nextcloud design variables, so updates do not break it. Disable the app to go back to the default look. Not affiliated with Google.</description>
	<version>1.0.0</version>
	<licence>agpl</licence>
	<author>Krlooo</author>
	<namespace>NubeTheme</namespace>
	<types>
		<logging/>
	</types>
	<category>customization</category>
	<website>https://github.com/Krlooo/nextcloud-nube-theme</website>
	<bugs>https://github.com/Krlooo/nextcloud-nube-theme/issues</bugs>
	<repository>https://github.com/Krlooo/nextcloud-nube-theme</repository>
	<screenshot>https://raw.githubusercontent.com/Krlooo/nextcloud-nube-theme/main/screenshots/files-light.png</screenshot>
	<screenshot>https://raw.githubusercontent.com/Krlooo/nextcloud-nube-theme/main/screenshots/login.png</screenshot>
	<screenshot>https://raw.githubusercontent.com/Krlooo/nextcloud-nube-theme/main/screenshots/files-dark.png</screenshot>
	<screenshot>https://raw.githubusercontent.com/Krlooo/nextcloud-nube-theme/main/screenshots/mobile.png</screenshot>
	<dependencies>
		<!-- Tested on 35 only. On a new major version Nextcloud disables the app and the default look returns. -->
		<nextcloud min-version="35" max-version="35"/>
	</dependencies>
</info>
